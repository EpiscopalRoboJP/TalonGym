{
  "schemaVersion": "1.0.0",
  "id": "centerstage_auto_easy",
  "displayName": "CENTERSTAGE AUTO easy (autodetect hardware)",
  "presets": {
    "fieldId": "centerstage_2023_field",
    "robotId": "mecanum_meepmeep_defaults",
    "scoringId": "centerstage_2023_scoring",
    "teammatePolicy": "none",
    "opponentPolicy": "static"
  },
  "algorithm": {
    "name": "recurrent_ppo",
    "learningRate": 0.0003,
    "gamma": 0.99,
    "gaeLambda": 0.95,
    "clipRange": 0.2,
    "nSteps": 128,
    "batchSize": 256,
    "nEpochs": 10,
    "entCoef": 0.01,
    "lstmHiddenSize": 256
  },
  "actionTier": "high_level_waypoint",
  "computeProfile": "auto",
  "nEnvs": 8,
  "episode": {
    "controlHz": 25,
    "durationS": 30,
    "physicsSubsteps": 2
  },
  "domainRandomization": {
    "poseJitterIn": 1.0,
    "headingJitterDeg": 2.0,
    "motorStrengthRange": [
      0.9,
      1.1
    ],
    "sensorNoiseScale": 1.0,
    "fieldBuildToleranceIn": 1.0,
    "curriculum": [
      {
        "untilFrac": 0.2,
        "unlock": [
          "motif_known_at_t0"
        ]
      },
      {
        "untilFrac": 1.0,
        "unlock": [
          "motif_must_sense",
          "full_noise"
        ]
      }
    ]
  },
  "budget": {
    "totalEnvSteps": 250000,
    "wallClockLimitS": 3600,
    "earlyStopNoImproveSteps": 100000
  },
  "evaluation": {
    "nTrials": 500,
    "confidence": 0.95,
    "heldOutSeedStart": 10000000,
    "pairCommonRandomNumbers": true
  },
  "objective": "mean_true_score",
  "export": {
    "onnx": false,
    "roadRunnerDialect": "rr1_actions"
  }
}
