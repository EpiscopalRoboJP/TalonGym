{
  "schemaVersion": "1.0.0",
  "id": "biobuzz_auto_lightweight",
  "displayName": "BIOBUZZ AUTO lightweight CPU",
  "presets": {
    "fieldId": "biobuzz_2026_field_v1",
    "robotId": "gobilda_mecanum_starter",
    "scoringId": "biobuzz_2026_scoring_v1",
    "teammatePolicy": "none",
    "opponentPolicy": "static"
  },
  "algorithm": {
    "name": "bc_then_ppo",
    "learningRate": 0.0003,
    "gamma": 0.99,
    "gaeLambda": 0.95,
    "clipRange": 0.2,
    "nSteps": 128,
    "batchSize": 256,
    "nEpochs": 10,
    "entCoef": 0.01,
    "lstmHiddenSize": 256,
    "bcWarmupSteps": 2048,
    "groupSize": 4
  },
  "actionTier": "high_level_waypoint",
  "computeProfile": "lightweight_cpu",
  "nEnvs": 8,
  "episode": {
    "controlHz": 25,
    "durationS": 30,
    "physicsSubsteps": 2
  },
  "domainRandomization": {
    "poseJitterIn": 1.0,
    "headingJitterDeg": 2.0,
    "motorStrengthRange": [
      0.9,
      1.1
    ],
    "sensorNoiseScale": 1.0,
    "fieldBuildToleranceIn": 1.0,
    "curriculum": [
      {
        "untilFrac": 0.15,
        "unlock": [
          "spawn_at_launch",
          "mechanism_ready"
        ]
      },
      {
        "untilFrac": 0.4,
        "unlock": [
          "spawn_approach"
        ]
      },
      {
        "untilFrac": 0.75,
        "unlock": []
      },
      {
        "untilFrac": 1.0,
        "unlock": [
          "full_noise"
        ]
      }
    ]
  },
  "budget": {
    "totalEnvSteps": 5000000,
    "wallClockLimitS": 14400,
    "earlyStopNoImproveSteps": 1000000
  },
  "evaluation": {
    "nTrials": 500,
    "confidence": 0.95,
    "heldOutSeedStart": 10000000,
    "pairCommonRandomNumbers": true
  },
  "objective": "mean_true_score",
  "export": {
    "onnx": true,
    "roadRunnerDialect": "rr1_actions"
  }
}
