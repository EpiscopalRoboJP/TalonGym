{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talongym.dev/schemas/robot-preset.schema.json",
  "title": "RobotPreset",
  "description": "Pluggable drivetrain + sensors + mechanism capabilities. Schema 1.2.0 stores catalog assemblies as the source of truth; compile_assembly_to_preset() materializes the 1.1.0 physical contract. Defaults mirror MeepMeep so FTC users recognize the vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0", "1.1.0", "1.2.0"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-.]{1,63}$" },
    "displayName": { "type": "string" },
    "drivetrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["mecanum", "tank", "swerve"] },
        "trackWidthIn": { "type": "number", "default": 15, "description": "MeepMeep default 15 in" },
        "wheelDiameterIn": { "type": "number" },
        "wheelbaseIn": { "type": "number" },
        "strafeMultiplier": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 }
      }
    },
    "chassis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lengthIn", "widthIn", "massKg"],
      "properties": {
        "lengthIn": { "type": "number", "default": 18 },
        "widthIn": { "type": "number", "default": 18 },
        "heightIn": { "type": "number" },
        "massKg": { "type": "number", "exclusiveMinimum": 0 },
        "collisionShape": { "type": "string", "enum": ["aabb", "circle", "mesh"] },
        "footprint": {
          "type": "array",
          "description": "Convex hull vertices in the robot frame (+x forward, +y left), inches. Used when collisionShape is mesh so planar physics does not need the CAD file.",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "motors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeSpeedRpm", "stallTorqueNm"],
      "properties": {
        "count": { "type": "integer", "minimum": 2 },
        "freeSpeedRpm": { "type": "number", "exclusiveMinimum": 0 },
        "stallTorqueNm": { "type": "number", "exclusiveMinimum": 0 },
        "currentLimitA": { "type": "number", "exclusiveMinimum": 0 },
        "gearRatio": { "type": "number", "exclusiveMinimum": 0 },
        "nominalVoltageV": { "type": "number", "default": 12 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxVelInPerS", "maxAccelInPerS2", "maxAngVelDegPerS", "maxAngAccelDegPerS2"],
      "description": "MeepMeep DefaultBotBuilder vocabulary. Product default: 30 in/s, 30 in/s², 60 deg/s, 60 deg/s², 15 in track (see drivetrain.trackWidthIn). Sample MeepMeep snippets sometimes use 60/60/180/180 — those are NOT our shipped defaults.",
      "properties": {
        "maxVelInPerS": { "type": "number", "default": 30 },
        "maxAccelInPerS2": { "type": "number", "default": 30 },
        "maxAngVelDegPerS": { "type": "number", "default": 60 },
        "maxAngAccelDegPerS2": { "type": "number", "default": 60 }
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sagEnabled": { "type": "boolean", "default": false },
        "internalResistanceOhm": { "type": "number", "minimum": 0 }
      }
    },
    "odometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encoderTicksPerRev": { "type": "number" },
        "positionNoiseStdIn": { "type": "number", "minimum": 0 },
        "headingNoiseStdDeg": { "type": "number", "minimum": 0 },
        "slipNoiseStd": { "type": "number", "minimum": 0 }
      }
    },
    "sensors": {
      "type": "array",
      "items": { "$ref": "#/$defs/sensor" }
    },
    "intakes": {
      "type": "array",
      "description": "Capture volumes in the robot frame (+x forward). Empty or omitted keeps the omnidirectional hull fallback.",
      "items": { "$ref": "#/$defs/intake" }
    },
    "launchers": {
      "type": "array",
      "description": "Legacy launcher metadata. Physical presets bind launch behavior through piecePath and actuators.",
      "items": { "$ref": "#/$defs/launcher" }
    },
    "mechanisms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity"],
      "properties": {
        "capacity": { "type": "integer", "minimum": 0, "description": "Held scoring elements. BIOBUZZ preload is 4 POLLEN (verify vs current manual)." },
        "intakeCycleTimeS": { "type": "number", "minimum": 0 },
        "scoreCycleTimeS": { "type": "number", "minimum": 0 },
        "canIntakeWhileMoving": { "type": "boolean" },
        "canScoreWhileMoving": { "type": "boolean" },
        "launchCapable": { "type": "boolean" },
        "climbCapable": { "type": "boolean" },
        "fsmId": { "type": "string", "description": "Named mechanism state machine from the engine catalog, parameterized by this object — not season-hardcoded." }
      }
    },
    "defaultActionTier": {
      "type": "string",
      "enum": ["high_level_waypoint", "low_level_velocity", "physical_actuators"]
    },
    "visualAsset": {
      "type": "string",
      "description": "Render-only robot glTF/GLB under var/assets/. Physics ignores this."
    },
    "collisionAsset": {
      "type": "string",
      "description": "Simplified convex-hull STL used when chassis.collisionShape is mesh (MuJoCo)."
    },
    "visualOffset": {
      "type": "object",
      "additionalProperties": false,
      "description": "Align CAD origin with chassis center. Inches, robot frame (+x forward, +y left, +z up).",
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 },
        "z": { "type": "number", "default": 0 },
        "yawDeg": { "type": "number", "default": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      }
    },
    "policyInterfaceVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of normalized actuator actions and sensor observations used by checkpoints."
    },
    "rigidParts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rigidPart" }
    },
    "joints": {
      "type": "array",
      "items": { "$ref": "#/$defs/joint" }
    },
    "actuators": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actuator" }
    },
    "powerSystem": { "$ref": "#/$defs/powerSystem" },
    "piecePath": { "$ref": "#/$defs/piecePath" },
    "mechanismSensors": {
      "type": "array",
      "items": { "$ref": "#/$defs/mechanismSensor" }
    },
    "assembly": { "$ref": "#/$defs/assembly" },
    "functionalBindings": { "$ref": "#/$defs/functionalBindings" },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/assemblyWarning" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.0.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "drivetrain",
          "chassis",
          "motors",
          "constraints",
          "sensors",
          "mechanisms",
          "defaultActionTier"
        ]
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.1.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "drivetrain",
          "chassis",
          "motors",
          "constraints",
          "sensors",
          "mechanisms",
          "defaultActionTier",
          "policyInterfaceVersion",
          "rigidParts",
          "joints",
          "actuators",
          "powerSystem",
          "piecePath",
          "mechanismSensors"
        ]
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.2.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["assembly"]
      }
    }
  ],
  "$defs": {
    "assemblyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$"
    },
    "mountRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "mountId"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/assemblyId" },
        "mountId": { "type": "string", "minLength": 1 },
        "patternIndex": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "assemblyInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sku"],
      "properties": {
        "id": { "$ref": "#/$defs/assemblyId" },
        "sku": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
        },
        "pose": { "$ref": "#/$defs/transform" }
      }
    },
    "assemblyConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent", "child"],
      "properties": {
        "id": { "$ref": "#/$defs/assemblyId" },
        "parent": { "$ref": "#/$defs/mountRef" },
        "child": { "$ref": "#/$defs/mountRef" },
        "spinDeg": { "type": "number" },
        "jointType": { "type": "string", "enum": ["fixed", "hinge", "slide"] },
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parent", "child"],
          "properties": {
            "parent": { "$ref": "#/$defs/mountRef" },
            "child": { "$ref": "#/$defs/mountRef" }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instances", "connections"],
      "properties": {
        "rootInstanceId": { "$ref": "#/$defs/assemblyId" },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" }
          }
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assemblyInstance" }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/assemblyConnection" }
        }
      }
    },
    "functionalBindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confirmed": { "type": "boolean" },
        "includeScoringTopology": { "type": "boolean" },
        "drivetrain": { "$ref": "#/properties/drivetrain" },
        "instanceRoles": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assemblyWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["info", "warning"] },
        "message": { "type": "string", "minLength": 1 },
        "instanceId": { "$ref": "#/$defs/assemblyId" }
      }
    },
    "poseOnRobot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "description": "Inches, robot +x forward" },
        "y": { "type": "number", "description": "Inches, robot +y left" },
        "z": { "type": "number", "description": "Inches above tile" },
        "headingDeg": { "type": "number" },
        "pitchDeg": { "type": "number" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 },
        "z": { "type": "number", "default": 0 },
        "rollDeg": { "type": "number", "default": 0 },
        "pitchDeg": { "type": "number", "default": 0 },
        "yawDeg": { "type": "number", "default": 0 }
      }
    },
    "collisionShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sizeIn"],
          "properties": {
            "kind": { "const": "box" },
            "sizeIn": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number", "exclusiveMinimum": 0 }
            },
            "pose": { "$ref": "#/$defs/transform" },
            "friction": { "type": "number", "minimum": 0 },
            "restitution": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "radiusIn"],
          "properties": {
            "kind": { "type": "string", "enum": ["sphere", "cylinder", "capsule"] },
            "radiusIn": { "type": "number", "exclusiveMinimum": 0 },
            "lengthIn": { "type": "number", "minimum": 0 },
            "pose": { "$ref": "#/$defs/transform" },
            "friction": { "type": "number", "minimum": 0 },
            "restitution": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "asset"],
          "properties": {
            "kind": { "const": "convex_mesh" },
            "asset": { "type": "string" },
            "pose": { "$ref": "#/$defs/transform" },
            "friction": { "type": "number", "minimum": 0 },
            "restitution": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "rigidPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "massKg", "collision"],
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "pose": { "$ref": "#/$defs/transform" },
        "massKg": { "type": "number", "exclusiveMinimum": 0 },
        "centerOfMassIn": { "$ref": "#/$defs/transform" },
        "inertiaKgM2": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "collision": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/collisionShape" }
        },
        "visualAsset": { "type": "string" },
        "visualPose": { "$ref": "#/$defs/transform" }
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "parentPartId", "childPartId"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["fixed", "hinge", "slide"] },
        "parentPartId": { "type": "string" },
        "childPartId": { "type": "string" },
        "anchorIn": { "$ref": "#/$defs/transform" },
        "axis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "limit": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "damping": { "type": "number", "minimum": 0 },
        "frictionLoss": { "type": "number", "minimum": 0 },
        "backlash": { "type": "number", "minimum": 0 }
      }
    },
    "motorCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominalVoltageV", "freeSpeedRpm", "stallTorqueNm", "stallCurrentA", "freeCurrentA"],
      "properties": {
        "nominalVoltageV": { "type": "number", "exclusiveMinimum": 0 },
        "freeSpeedRpm": { "type": "number", "exclusiveMinimum": 0 },
        "stallTorqueNm": { "type": "number", "exclusiveMinimum": 0 },
        "stallCurrentA": { "type": "number", "exclusiveMinimum": 0 },
        "freeCurrentA": { "type": "number", "minimum": 0 }
      }
    },
    "actuator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "motor",
        "gearRatio",
        "efficiency",
        "rotorInertiaKgM2",
        "loadInertiaKgM2",
        "currentLimitA",
        "controllerLatencyMs"
      ],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["velocity_motor", "position_motor", "servo"] },
        "jointId": { "type": ["string", "null"] },
        "motor": { "$ref": "#/$defs/motorCurve" },
        "gearRatio": { "type": "number", "exclusiveMinimum": 0 },
        "efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "rotorInertiaKgM2": { "type": "number", "minimum": 0 },
        "loadInertiaKgM2": { "type": "number", "exclusiveMinimum": 0 },
        "viscousFrictionNmPerRadS": { "type": "number", "minimum": 0 },
        "coulombFrictionNm": { "type": "number", "minimum": 0 },
        "currentLimitA": { "type": "number", "exclusiveMinimum": 0 },
        "controllerLatencyMs": { "type": "number", "minimum": 0 },
        "commandRatePerS": { "type": "number", "exclusiveMinimum": 0 },
        "travelLimit": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "targetRpm": { "type": "number", "minimum": 0 },
        "kp": { "type": "number", "minimum": 0 },
        "kd": { "type": "number", "minimum": 0 },
        "thermal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ambientC", "shutdownC", "thermalResistanceCPerW", "thermalMassJPerC"],
          "properties": {
            "ambientC": { "type": "number" },
            "shutdownC": { "type": "number" },
            "thermalResistanceCPerW": { "type": "number", "exclusiveMinimum": 0 },
            "thermalMassJPerC": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "powerSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openCircuitVoltageV",
        "internalResistanceOhm",
        "capacityAh",
        "initialStateOfCharge",
        "brownoutVoltageV"
      ],
      "properties": {
        "openCircuitVoltageV": { "type": "number", "exclusiveMinimum": 0 },
        "internalResistanceOhm": { "type": "number", "minimum": 0 },
        "capacityAh": { "type": "number", "exclusiveMinimum": 0 },
        "initialStateOfCharge": { "type": "number", "minimum": 0, "maximum": 1 },
        "brownoutVoltageV": { "type": "number", "exclusiveMinimum": 0 },
        "maxCurrentA": { "type": "number", "exclusiveMinimum": 0 },
        "voltageNoiseStdV": { "type": "number", "minimum": 0 },
        "currentNoiseStdA": { "type": "number", "minimum": 0 }
      }
    },
    "piecePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intakeActuatorId",
        "conveyorActuatorId",
        "flywheelActuatorId",
        "gateActuatorId",
        "storageSlots",
        "muzzlePose"
      ],
      "properties": {
        "intakeActuatorId": { "type": "string" },
        "conveyorActuatorId": { "type": "string" },
        "flywheelActuatorId": { "type": "string" },
        "hoodActuatorId": { "type": ["string", "null"] },
        "turretActuatorId": { "type": ["string", "null"] },
        "gateActuatorId": { "type": "string" },
        "storageSlots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transform" }
        },
        "intakePose": { "$ref": "#/$defs/transform" },
        "muzzlePose": { "$ref": "#/$defs/transform" },
        "flywheelPose": { "$ref": "#/$defs/transform" },
        "muzzleClearanceIn": { "type": "number", "minimum": 0 },
        "wheelRadiusIn": { "type": "number", "exclusiveMinimum": 0 },
        "launchEfficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "compressionIn": { "type": "number", "minimum": 0 },
        "dragCoefficient": { "type": "number", "minimum": 0 },
        "magnusCoefficient": { "type": "number", "minimum": 0 },
        "coefficientVariation": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "mechanismSensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sampleRateHz"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["encoder", "rpm", "beam_break", "joint_position", "motor_current", "battery_voltage"]
        },
        "actuatorId": { "type": "string" },
        "jointId": { "type": "string" },
        "pose": { "$ref": "#/$defs/transform" },
        "sampleRateHz": { "type": "number", "exclusiveMinimum": 0 },
        "quantization": { "type": "number", "minimum": 0 },
        "noiseStd": { "type": "number", "minimum": 0 },
        "dropoutRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "poseOnRobot"],
      "properties": {
        "id": { "type": "string" },
        "poseOnRobot": { "$ref": "#/$defs/poseOnRobot" },
        "widthIn": { "type": "number", "exclusiveMinimum": 0, "description": "Mouth width, perpendicular to heading" },
        "reachIn": { "type": "number", "minimum": 0, "description": "Capture depth in front of the pose, along heading" },
        "heightIn": { "type": "number", "exclusiveMinimum": 0 },
        "cycleTimeS": { "type": "number", "minimum": 0 },
        "maxSpeedInPerS": { "type": "number", "minimum": 0 },
        "canRunWhileMoving": { "type": "boolean" }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "poseOnRobot", "muzzleSpeedInPerS"],
      "properties": {
        "id": { "type": "string" },
        "poseOnRobot": { "$ref": "#/$defs/poseOnRobot" },
        "aimMode": { "type": "string", "enum": ["chassis_fixed", "turret"], "default": "chassis_fixed" },
        "yawRangeDeg": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "pitchRangeDeg": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "muzzleSpeedInPerS": { "type": "number", "exclusiveMinimum": 0 },
        "spinupTimeS": { "type": "number", "minimum": 0 },
        "cycleTimeS": { "type": "number", "minimum": 0 },
        "canLaunchWhileMoving": { "type": "boolean" }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["apriltag_camera", "distance", "color", "beam_break", "touch", "imu"]
        },
        "poseOnRobot": { "$ref": "#/$defs/poseOnRobot" },
        "fovDeg": { "type": "number" },
        "rangeIn": { "type": "number" },
        "falseNegativeRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "falsePositiveRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
